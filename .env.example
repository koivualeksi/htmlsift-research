HF_TOKEN=            # Optional for reproduction (public reads / avoids rate-limits); REQUIRED with write scope for a trainer's --push. https://huggingface.co/settings/tokens
HF_RESULTS_DATASET=  # HF dataset repo a trainer's --push writes results to, e.g. <you>/htmlsift-runs. Your own name -- nothing is hardcoded.
HF_MODELS_REPO=      # HF model repo a trainer's --push writes kept ckpts (--keep) to, e.g. <you>/htmlsift-models. Distinct from the results dataset; private until publish.


# --- RunPod operator (running the sweep on rented GPUs; NOT needed to reproduce) ---
# All from the RunPod console; the network volume lives in EU-RO-1 (has 4090s + the S3 API).
RUNPOD_API_KEY=""              # Settings -> API Keys: REST key. Launches and terminates pods (launch.py).
RUNPOD_DC="EU-RO-1"           # Datacenter of the volume. Picks the S3 endpoint and pins pods in-region for fast volume<->pod.
RUNPOD_VOLUME_KEY=""          # Storage: the network volume id. It IS the S3 bucket -- upload_data writes to it, pods mount it at /workspace.
RUNPOD_ENDPOINT_URL=""        # S3 endpoint. Optional: blank derives https://s3api-<dc>.runpod.io from RUNPOD_DC.
RUNPOD_S3_ACCESS_KEY=""       # S3 access-key id = your RunPod account user id (Settings -> S3 API Keys does not show it).
RUNPOD_S3_SECRET_ACCESS_KEY=""  # Settings -> S3 API Keys: the rps_... secret (shown once at creation).
